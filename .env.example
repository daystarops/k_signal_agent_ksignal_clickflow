# Required for vision + translation cards
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_AUDIT_MODEL=gpt-5.5
TRANSLATION_GUARDRAIL=true

# Optional but recommended: Naver Search APIs for Korean-native news/blog/cafe/image sourcing
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional n8n webhook that receives latest brief/card payload
WEBHOOK_URL=

# Browser identity
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124 Safari/537.36

# Optional canonical base for hosted article pages
SITE_BASE_URL=
PUBLIC_ISSUE_URL=https://read-ksignal.netlify.app/
